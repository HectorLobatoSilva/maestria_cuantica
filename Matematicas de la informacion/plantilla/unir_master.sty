%========================================================================%
% Configuración de Encabezados y Estilos de Página
%========================================================================%
\pagestyle{fancy}
\patchcmd{\chapter}{\thispagestyle{plain}}{\thispagestyle{fancy}}{}{}

\fancypagestyle{mainmatter}{%
    \fancyhead{} \lhead{{\color{azul}\docAuthorV}} \rhead{\degreeV}
    \lfoot{{\color{azul}\docTitleV}} \cfoot{} \rfoot{\thepage\ de \getpagerefnumber{LastPage}}
}

\fancypagestyle{frontmatter}{%
    \fancyhead{} \lhead{{\color{azul}\docAuthorV}} \rhead{\degreeV}
    \lfoot{{\color{azul}\docTitleV}} \cfoot{} \rfoot{\thepage}
}

